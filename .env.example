# Copy to .env and replace secrets. Never commit the real .env file.
# Map stable tenant IDs to one key or a list of keys during rotation.
ALL2MD_API_KEYS_JSON={"tenant-a":"replace-with-at-least-32-random-characters"}
# Legacy single-tenant alternative (do not set it to a key already listed above):
# ALL2MD_API_KEY=replace-with-at-least-32-random-characters
ALL2MD_DATA_DIR=/var/lib/all2md
ALL2MD_MAX_UPLOAD_MB=50
ALL2MD_MAX_RESULT_MB=25
ALL2MD_CONVERSION_TIMEOUT_SECONDS=300
ALL2MD_CONVERSION_CONCURRENCY=2
ALL2MD_QUEUE_CAPACITY=100
ALL2MD_JOB_TTL_SECONDS=86400
ALL2MD_RATE_LIMIT_PER_MINUTE=120
ALL2MD_SYNC_ENDPOINTS_ENABLED=true
ALL2MD_DOCS_ENABLED=false
ALL2MD_LOG_JSON=true
ALL2MD_LITEPARSE_OCR=true
ALL2MD_LITEPARSE_OCR_LANGUAGE=eng
ALL2MD_LITEPARSE_MAX_PAGES=200
